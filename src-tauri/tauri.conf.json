{
  "productName": "GatitoTuber",
  "version": "1.0.0",
  "identifier": "com.gatito.tuber",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [{ "label": "main", "title": "GatitoTuber", "width": 520, "height": 640,
      "transparent": true, "decorations": false, "shadow": false, "resizable": true }]
  },
  "bundle": { "active": true, "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
